<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.hr.mapper.DeptMapper">

    <resultMap id="deptResultMap" type="com.example.hr.domain.Dept">
        <id property="deptId" column="DEPT_ID"/>
        <result property="deptName" column="DEPT_NAME"/>
        <result property="location" column="LOCATION"/>
    </resultMap>

    <resultMap id="deptListRowResultMap" type="com.example.hr.dto.DeptListRow">
        <id property="deptId" column="DEPT_ID"/>
        <result property="deptName" column="DEPT_NAME"/>
        <result property="location" column="LOCATION"/>
        <result property="memberCount" column="MEMBER_COUNT"/>
        <result property="avgSalary" column="AVG_SALARY"/>
    </resultMap>

    <select id="selectAllWithStats" resultMap="deptListRowResultMap">
        SELECT d.DEPT_ID, d.DEPT_NAME, d.LOCATION,
               COUNT(e.EMP_ID) AS MEMBER_COUNT,
               COALESCE(ROUND(AVG(e.SALARY)), 0) AS AVG_SALARY
        FROM DEPT d
        LEFT JOIN EMP e ON e.DEPT_ID = d.DEPT_ID AND e.ACTIVE = 1
        GROUP BY d.DEPT_ID, d.DEPT_NAME, d.LOCATION
        ORDER BY d.DEPT_ID ASC
    </select>

    <select id="selectAll" resultMap="deptResultMap">
        SELECT DEPT_ID, DEPT_NAME, LOCATION FROM DEPT ORDER BY DEPT_ID ASC
    </select>

    <select id="selectById" resultMap="deptResultMap">
        SELECT DEPT_ID, DEPT_NAME, LOCATION FROM DEPT WHERE DEPT_ID = #{deptId}
    </select>

    <insert id="insert" parameterType="com.example.hr.domain.Dept" useGeneratedKeys="true" keyProperty="deptId">
        INSERT INTO DEPT (DEPT_NAME, LOCATION) VALUES (#{deptName}, #{location})
    </insert>

    <!-- 부분 수정(<set>+<if>)이 필요해지면 EmpMapper.xml의 update 주석 참고 -->
    <update id="update" parameterType="com.example.hr.domain.Dept">
        UPDATE DEPT SET DEPT_NAME = #{deptName}, LOCATION = #{location} WHERE DEPT_ID = #{deptId}
    </update>

    <delete id="deleteById">
        DELETE FROM DEPT WHERE DEPT_ID = #{deptId}
    </delete>

</mapper>
