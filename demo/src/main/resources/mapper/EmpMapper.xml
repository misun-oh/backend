<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.EmpMapper">

  <sql id="empColumns">
    EMP_ID, EMP_NAME, EMAIL, DEPT_ID, JOB_CODE, SALARY, HIRE_DATE,
    (CASE WHEN ENT_YN = 'N' THEN 1 ELSE 0 END) AS ACTIVE
  </sql>

  <select id="selectByCond" resultType="Emp">
    SELECT *
    FROM EMP
    ORDER BY EMP_ID
  </select>

  <select id="findById" resultType="Emp">
    SELECT <include refid="empColumns"/>
    FROM EMP
    WHERE EMP_ID = #{empId}
  </select>
</mapper>